{
  "info": {
    "name": "SimpleFood API - Autenticacion y Reservas",
    "description": "Script automatizado de pruebas funcionales de la API REST de SimpleFood.\nMateria: Pruebas de Calidad de Software - AA1 Taller de scripts automatizados.\n\nEjecucion: npm test (Newman) con el servidor en http://localhost:8080.\nConvencion: los casos negativos declaran esperadoEstado/esperadoError en su pre-request y el script de pruebas de la coleccion los verifica (aserciones reutilizables).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "tiempoMaximoMs",
      "value": "1000"
    }
  ],
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Las expectativas de casos negativos aplican solo a la peticion que las declara",
          "pm.variables.unset(\"esperadoEstado\");",
          "pm.variables.unset(\"esperadoError\");",
          "// Fechas dinamicas para que la coleccion sea repetible en cualquier dia",
          "const pad = n => String(n).padStart(2, \"0\");",
          "const dia = d => d.getFullYear() + \"-\" + pad(d.getMonth() + 1) + \"-\" + pad(d.getDate());",
          "const enDias = n => { const d = new Date(); d.setDate(d.getDate() + n); return d; };",
          "pm.collectionVariables.set(\"diaReserva\", dia(enDias(3)));",
          "pm.collectionVariables.set(\"fechaReserva\", dia(enDias(3)) + \"T19:30\");",
          "pm.collectionVariables.set(\"fechaPasada\", dia(enDias(-1)) + \"T19:30\");",
          "pm.collectionVariables.set(\"fechaFueraHorario\", dia(enDias(3)) + \"T23:00\");"
        ]
      }
    },
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// ---- Aserciones comunes a TODAS las peticiones ----",
          "const limite = Number(pm.collectionVariables.get(\"tiempoMaximoMs\"));",
          "pm.test(\"[comun] Responde en menos de \" + limite + \" ms\", () => {",
          "    pm.expect(pm.response.responseTime).to.be.below(limite);",
          "});",
          "pm.test(\"[comun] Content-Type es JSON\", () => {",
          "    pm.response.to.have.header(\"Content-Type\");",
          "    pm.expect(pm.response.headers.get(\"Content-Type\")).to.include(\"application/json\");",
          "});",
          "// ---- Verificacion declarativa de casos negativos ----",
          "const estado = pm.variables.get(\"esperadoEstado\");",
          "const error = pm.variables.get(\"esperadoError\");",
          "if (estado) {",
          "    pm.test(\"[negativo] Codigo HTTP \" + estado, () => pm.response.to.have.status(Number(estado)));",
          "}",
          "if (error) {",
          "    pm.test(\"[negativo] Mensaje de error: \" + error, () => {",
          "        pm.expect(pm.response.json().error).to.eql(error);",
          "    });",
          "}"
        ]
      }
    }
  ],
  "item": [
    {
      "name": "01 Autenticacion",
      "item": [
        {
          "name": "Login cliente (credenciales validas)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Codigo HTTP 200\", () => pm.response.to.have.status(200));",
                  "const r = pm.response.json();",
                  "pm.test(\"Devuelve token de sesion\", () => {",
                  "    pm.expect(r.token).to.be.a(\"string\").and.to.have.length.above(20);",
                  "});",
                  "pm.test(\"El usuario autenticado tiene rol CLIENTE\", () => {",
                  "    pm.expect(r.usuario.rol).to.eql(\"CLIENTE\");",
                  "    pm.expect(r.usuario.correo).to.eql(pm.environment.get(\"correoCliente\"));",
                  "});",
                  "pm.test(\"La respuesta no expone la clave\", () => {",
                  "    pm.expect(pm.response.text()).to.not.include(\"clave\");",
                  "});",
                  "pm.collectionVariables.set(\"tokenCliente\", r.token);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"correo\": \"{{correoCliente}}\",\n  \"clave\": \"{{claveCliente}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Login mesero (credenciales validas)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Codigo HTTP 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"El usuario autenticado tiene rol MESERO\", () => {",
                  "    pm.expect(pm.response.json().usuario.rol).to.eql(\"MESERO\");",
                  "});",
                  "pm.collectionVariables.set(\"tokenMesero\", pm.response.json().token);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"correo\": \"{{correoMesero}}\",\n  \"clave\": \"{{claveMesero}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
        {
          "name": "Login con clave incorrecta",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.variables.set(\"esperadoEstado\", 400);",
                  "pm.variables.set(\"esperadoError\", \"Credenciales invalidas\");"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"No entrega token\", () => pm.expect(pm.response.json()).to.not.have.property(\"token\"));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"correo\": \"{{correoCliente}}\",\n  \"clave\": \"clave-equivocada\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        }
      ]
