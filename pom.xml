<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>com.simplefood</groupId>
    <artifactId>simplefood</artifactId>
    <version>1.0.0</version>
    <packaging>jar</packaging>
    <name>SimpleFood - SIGR</name>
    <description>Sistema Integral de Gestion de Restaurante</description>

    <properties>
        <maven.compiler.release>21</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <junit.version>5.10.3</junit.version>
        <selenium.version>4.33.0</selenium.version>
        <!-- Las pruebas de interfaz (Selenium) se ejecutan solo con el perfil e2e -->
        <grupos.excluidos>e2e</grupos.excluidos>
        <grupos.incluidos></grupos.incluidos>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.seleniumhq.selenium</groupId>
            <artifactId>selenium-java</artifactId>
            <version>${selenium.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>3.2.5</version>
                <configuration>
                    <groups>${grupos.incluidos}</groups>
                    <excludedGroups>${grupos.excluidos}</excludedGroups>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <version>3.3.0</version>
                <configuration>
                    <archive>
                        <manifest>
                            <mainClass>com.simplefood.App</mainClass>
                        </manifest>
                    </archive>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <!-- mvn test -Pe2e : ejecuta solo las pruebas end-to-end con Selenium -->
        <profile>
            <id>e2e</id>
            <properties>
                <grupos.incluidos>e2e</grupos.incluidos>
                <grupos.excluidos></grupos.excluidos>
            </properties>
        </profile>
    </profiles>
</project>
